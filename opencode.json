{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "package.json": "deny",
      "package-lock.json": "deny",
      "pnpm-lock.yaml": "deny",
      "tsconfig*.json": "deny",
      ".gitmodules": "deny",
      ".github/**": "deny",
      ".gitlab/**": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.crt": "deny"
    },
    "task": "ask",
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "agent": {
    "cypress": {
      "permission": {
        "edit": {
          "cypress/**": "allow",
          "driveup-admin/cypress/**": "allow",
          "driveup-portal/cypress/**": "allow",
          "driveup-api/**": "deny"
        },
        "bash": "allow",
        "task": "allow",
        "glob": "allow",
        "grep": "allow",
        "read": "allow",
        "list": "allow"
      }
    },
    "explore": {
      "permission": {
        "edit": "deny",
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "maestro": {
      "permission": {
        "edit": {
          "driveup-mobile/**/*.yaml": "allow",
          "driveup-mobile/**/maestro/**": "allow",
          "gnosa/**": "allow"
        }
      }
    },
    "product-owner": {
      "permission": {
        "edit": "deny",
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "reviewer": {
      "permission": {
        "edit": "deny",
        "task": "deny"
      }
    },
    "tester": {
      "permission": {
        "edit": {
          "**/*test*/**": "allow",
          "**/*spec*/**": "allow",
          "cypress/**": "allow",
          "driveup-mobile/**/test/**": "allow",
          "driveup-admin/**/test/**": "allow",
          "driveup-portal/**/test/**": "allow",
          "driveup-api/**/test/**": "allow"
        }
      }
    }
  },
  "mcp": {
    "jira": {
      "type": "local",
      "command": ["npx", "-y", "@mcp-devtools/jira"],
      "environment": {
        "JIRA_URL": "https://intelact.atlassian.net",
        "JIRA_API_MAIL": "manager@intelact.co",
        "JIRA_API_KEY": "ATATT3xFfGF0XuC-hm0qhuaHtflP0e_d4_NbczIuCjR8xH2yQY5_kj91Y7xsXL9f32xzWZo2ivDRwu2i7QrC5aBLhxNbMNG7ud5McXa49VWkcnk73iDaaNjFhmzJO0MVPqUxhy-is53zNcxOvKsQCYHUs_jse6mXzV5941NFLL_lB00Bno9SO-Y=CF79BFAC"
      },
      "enabled": true
    }
  }
}
