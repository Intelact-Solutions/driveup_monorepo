{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "package.json": "deny",
      "package-lock.json": "deny",
      "pnpm-lock.yaml": "deny",
      "tsconfig*.json": "deny",
      ".gitmodules": "deny",
      ".github/**": "deny",
      ".gitlab/**": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.crt": "deny"
    },
    "task": "ask",
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "agent": {
    "cypress": {
      "permission": {
        "edit": {
          "cypress/**": "allow",
          "driveup-admin/cypress/**": "allow",
          "driveup-portal/cypress/**": "allow",
          "driveup-api/**": "deny"
        }
      }
    },
    "explore": {
      "permission": {
        "edit": "deny",
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "maestro": {
      "permission": {
        "edit": {
          "driveup-mobile/**/*.yaml": "allow",
          "driveup-mobile/**/maestro/**": "allow",
          "gnosa/**": "allow"
        }
      }
    },
    "product-owner": {
      "permission": {
        "edit": "deny",
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "reviewer": {
      "permission": {
        "edit": "deny",
        "task": "deny"
      }
    },
    "tester": {
      "permission": {
        "edit": {
          "**/*test*/**": "allow",
          "**/*spec*/**": "allow",
          "cypress/**": "allow",
          "driveup-mobile/**/test/**": "allow",
          "driveup-admin/**/test/**": "allow",
          "driveup-portal/**/test/**": "allow",
          "driveup-api/**/test/**": "allow"
        }
      }
    }
  }
}